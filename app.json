      "bundleIdentifier": "com.objectpass.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E2530"
      },
      "package": "com.objectpass.app"
    },
    "plugins": [
      "expo-sqlite"
    ]
  }
}
